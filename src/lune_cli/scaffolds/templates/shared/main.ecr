require "lune"

# Third-party plugins are published as Crystal shards. Add them to shard.yml,
# `require` them here, and call `Lune.use(MyPlugin.new)` before `Lune.run`.
# Built-in plugins (events, tray, clipboard, …) are registered automatically.
#
# require "lune_mqtt"
# Lune.use(LuneMqtt::Plugin.new)

class Welcome
  include Lune::Bindable

  @[Lune::Bind]
  def greet(name : String) : String
    name = name.empty? ? "stranger" : name
    "Hello, #{name}!"
  end
end

# A second binding surface. The class name becomes the JS namespace, so these
# methods are reachable from the frontend as `api.Counter.inc` / `api.Counter.dec`.
class Counter
  include Lune::Bindable

  @[Lune::Bind]
  def inc(value : Int32) : Int32
    value + 1
  end

  @[Lune::Bind]
  def dec(value : Int32) : Int32
    value - 1
  end
end

app = Lune::App.new
app.install(Welcome.new)
app.install(Counter.new)

Lune.run(app, assets: "frontend/dist") do |opts|
  opts.title = "<%= @ctx.app_name %>"
  opts.width = 1400
  opts.height = 800
end
